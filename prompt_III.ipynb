    "    \"# Perform GridSearchCV for each model\\n\",\n",
    "    \"tuned_results = []\\n\",\n",
    "    \"best_models = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"for name, clf in models.items():\\n\",\n",

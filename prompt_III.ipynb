    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"# Establish baseline with DummyClassifier\\n\",\n",
    "    \"baseline_strategies = ['most_frequent', 'stratified', 'uniform']\\n\",\n",
    "    \"baseline_results = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for strategy in baseline_strategies:\\n\",\n",
    "    \"    baseline = DummyClassifier(strategy=strategy, random_state=42)\\n\",\n",
    "    \"    baseline.fit(X_train, y_train)\\n\",\n",
    "    \"    base_pred = baseline.predict(X_test)\\n\",\n",
    "    \"    base_proba = baseline.predict_proba(X_test)[:, 1] if hasattr(baseline, 'predict_proba') else None\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    acc = accuracy_score(y_test, base_pred)\\n\",\n",
    "    \"    f1 = f1_score(y_test, base_pred)\\n\",\n",

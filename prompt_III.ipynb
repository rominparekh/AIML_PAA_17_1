    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Encode target and set up features\\n\",\n",
    "    \"df = df.copy()\\n\",\n",
    "    \"df['target'] = (df['y'] == 'yes').astype(int)\\n\",\n",
    "    \"\\n\",\n",

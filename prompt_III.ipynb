    "    \"    \\n\",\n",
    "    \"    tuned_results.append({\\n\",\n",
    "    \"        'Model': name,\\n\",\n",
    "    \"        'Best Params': str(gs.best_params_),\\n\",\n",
    "    \"        'CV Best ROC AUC': round(gs.best_score_, 3),\\n\",\n",
    "    \"        'Tuning Time (s)': round(t1 - t0, 1),\\n\",\n",
    "    \"        'Test Accuracy': round(test_acc, 3),\\n\",\n",
    "    \"        'Test F1': round(test_f1, 3),\\n\",\n",
    "    \"        'Test ROC AUC': round(test_auc, 3) if not np.isnan(test_auc) else 'N/A'\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"    \\n\",\n",

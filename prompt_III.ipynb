    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Create preprocessing pipelines\\n\",\n",
    "    \"numeric_transformer = Pipeline(steps=[\\n\",\n",
    "    \"    ('imputer', SimpleImputer(strategy='median')),\\n\",\n",
    "    \"    ('scaler', StandardScaler())\\n\",\n",
    "    \"])\\n\",\n",
    "    \"\\n\",\n",
